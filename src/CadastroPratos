import java.util.ArrayList;
import java.util.Scanner;
//Arraylist funciona como uma lista e pode ir aumentando conforme vai sendo adicionado mais pratos

public class CadastroPratos implements OperacoesPrato{

    private ArrayList<Prato>pratos = new ArrayList<>();
    // vai criar a lista de pratos

    @Override
    public void cadastrarPrato(Scanner scanner) {

        System.out.println("/n--- CADASTRO DE PRATO ---");

        System.out.print("Nome do Prato: ");
        String nome = scanner.nextLine();

        System.out.print("Descrição: ");
        String descricao = scanner.nextLine();

        System.out.print("Categoria: ");
        String categoria = scanner.nextLine();

        double preco;
        //diferença de print e println o print mostra o texto e continua na mesma linha, o println mostar o testo e pula pra proxima linha

        while (true) {
            try {
                System.out.print("Preço: R$ ");
                preco = Double.parseDouble(
                        scanner.nextLine().replace(",", ".")
                );
                //parsedouble transforma um texto string em numero double

                if (preco <= 0) {
                    System.out.println("O preço deve ser maior que zero.");
                    continue;
                }

                break;

            } catch (NumberFormatException e) {
                System.out.println("Ta errado isso ai digite um preço válido.");
                //number exeption é uma exceção que acontece quando tenta converter um texto em numero mas o formato da invaalido
                //try e catch é usado para evitar que o programa pare se for digitado um texto no lugar do preço
            }
        }

        Prato prato = new Prato(nome, descricao, categoria, preco);

        pratos.add(prato);

        System.out.println("Prato cadastrado com sucesso!");
    }

    @Override
    public void listarPratos() {

        System.out.println("\n--- PRATOS CADASTRADOS ---");

        if (pratos.isEmpty()) {
            System.out.println("Nenhum prato cadastrado.");
            return;
        }

        for (Prato prato : pratos) {
            System.out.println("----------------------");
            prato.exibirPrato();
        }
    }
}
